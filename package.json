### 2. `capacitor.config.json` (앱 이름 설정)
> 저장소 첫 화면(Root)에 `capacitor.config.json` 이름으로 만드세요. `appName`을 **"아이스마터"**로 설정하여 폰 바탕화면에 이 이름이 표시되도록 했습니다.

```json
{
  "appId": "com.rookie.ismarter",
  "appName": "아이스마터",
  "webDir": "www",
  "bundledWebRuntime": false
}
```[cite: 3]

---

### 3. `www/index.html` (앱 화면 및 학습 콘텐츠 소스코드)
> `www` 폴더를 만들고 그 안에 `index.html` 이름으로 만드세요. 앱 상단 타이틀도 **‘아이스마터’**로 변경되었습니다.

```html
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>아이스마터 - 초등 국어 어휘 마스터</title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #111111;
            --sub-text: #666666;
            --border-color: #e0e0e0;
            --card-bg: #f9f9f9;
            --accent: #000000;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .app-container { width: 100%; max-width: 480px; height: 100vh; max-height: 900px; background: var(--bg-color); border: 1px solid var(--border-color); display: flex; flex-direction: column; position: relative; overflow: hidden; }
        header { padding: 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; }
        header h1 { font-size: 1.2rem; font-weight: 700; }
        .screen { flex: 1; overflow-y: auto; padding: 20px; display: none; flex-direction: column; }
        .screen.active { display: flex; }
        input, select { width: 100%; padding: 14px; border: 1px solid var(--border-color); border-radius: 8px; font-size: 1rem; margin-bottom: 12px; outline: none; }
        button { width: 100%; padding: 14px; background-color: var(--accent); color: white; border: none; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; margin-bottom: 10px; }
        button.secondary { background-color: #f1f1f1; color: var(--text-color); }
        .center-box { display: flex; flex-direction: column; justify-content: flex-start; align-items: center; height: 100%; text-align: center; padding-top: 40px; }
        .menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
        .menu-card { background: var(--card-bg); border: 1px solid var(--border-color); padding: 20px; border-radius: 12px; text-align: left; cursor: pointer; }
        .menu-card h3 { font-size: 1rem; margin-bottom: 6px; }
        .menu-card p { font-size: 0.8rem; color: var(--sub-text); }
        .card-view { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; text-align: center; margin-bottom: 20px; min-height: 200px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .admin-section { background: #fafafa; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; margin-bottom: 15px; }
        .key-list { margin-top: 10px; max-height: 180px; overflow-y: auto; }
        .key-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; background: white; border: 1px solid var(--border-color); border-radius: 6px; margin-bottom: 6px; font-size: 0.85rem; }
    </style>
</head>
<body>

<div class="app-container">
    <header>
        <h1>🎓 아이스마터</h1>
        <div id="header-status" style="font-size: 0.8rem; color: #666;"></div>
    </header>

    <!-- 1. 라이센스 인증 화면 -->
    <div id="screen-license" class="screen active">
        <div class="center-box">
            <h2>아이스마터 라이센스</h2>
            <p style="color: var(--sub-text); margin-bottom: 24px; font-size: 0.95rem;">발급받은 라이센스 키를 입력하세요.</p>
            <input type="text" id="license-input" placeholder="라이센스 키 입력">
            <button onclick="verifyLicense()">입력하고 시작하기</button>
            <div style="margin-top: 20px; font-size: 0.8rem; color: #888; text-align: left; width: 100%;">
                * 관리자 테스트 키: <b>admin-master-key</b><br>
                * 일반 사용자 테스트 키: <b>ismarter-2026</b>
            </div>
        </div>
    </div>

    <!-- 2. 메인 대시보드 -->
    <div id="screen-home" class="screen">
        <div style="margin-bottom: 20px;">
            <h2 style="font-size: 1.3rem; margin-bottom: 4px;">환영합니다! 👋</h2>
            <p style="color: var(--sub-text); font-size: 0.9rem;">공부할 학습 콘텐츠를 선택하세요.</p>
        </div>
        <div class="menu-grid">
            <div class="menu-card" onclick="startStudy('four')">
                <h3>사자성어</h3>
                <p>초등 필수 사자성어</p>
            </div>
            <div class="menu-card" onclick="startStudy('proverb')">
                <h3>속담</h3>
                <p>재미있는 우리말 속담</p>
            </div>
            <div class="menu-card" onclick="startStudy('textbook')">
                <h3>교과서 어휘</h3>
                <p>학년별 핵심 국어 어휘</p>
            </div>
            <div class="menu-card" onclick="startStudy('camera')">
                <h3>📸 사진 어휘 퀴즈</h3>
                <p>추출된 어휘 카드 학습</p>
            </div>
        </div>
        <div style="margin-top: 30px;" id="admin-shortcut-box" style="display:none;">
            <button class="secondary" onclick="switchScreen('screen-admin')">⚙️ 관리자 패널 열기</button>
        </div>
    </div>

    <!-- 3. 학습 카드 화면 -->
    <div id="screen-study" class="screen">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <button class="secondary" style="width: auto; padding: 8px 14px; margin: 0;" onclick="switchScreen('screen-home')">← 홈으로</button>
            <span id="study-progress" style="font-size: 0.9rem; color: var(--sub-text);">1 / 4</span>
        </div>
        <div class="card-view" onclick="flipCard()">
            <h2 id="card-front" style="font-size: 1.4rem; margin-bottom: 10px;">단어</h2>
            <p id="card-back" style="color: var(--sub-text); display:none; font-weight: 600;">뜻 설명</p>
        </div>
        <p style="text-align: center; font-size: 0.8rem; color: var(--sub-text); margin-bottom: 15px;">카드를 누르면 뜻이 나타납니다</p>
        <button onclick="nextCard()">다음 단어</button>
    </div>

    <!-- 4. 관리자 패널 화면 -->
    <div id="screen-admin" class="screen">
        <button class="secondary" style="width: auto; padding: 8px 14px; margin-bottom: 15px;" onclick="switchScreen('screen-home')">← 홈으로</button>
        <h2 style="font-size: 1.2rem; margin-bottom: 15px;">⚙️ 관리자 제어 패널</h2>
        <div class="admin-section">
            <h3 style="font-size: 0.95rem; margin-bottom: 8px;">새 라이센스 키 발급</h3>
            <input type="text" id="new-key-input" placeholder="발급할 키 입력">
            <button onclick="generateKey()" style="margin-bottom: 0;">키 발급하기</button>
        </div>
        <div class="admin-section">
            <h3 style="font-size: 0.95rem; margin-bottom: 8px;">등록된 라이센스 목록</h3>
            <div class="key-list" id="key-list-container"></div>
        </div>
    </div>
</div>

<script>
    let licenses = [
        { key: "admin-master-key", role: "admin", active: true },
        { key: "ismarter-2026", role: "user", active: true }
    ];

    let studyData = {
        four: [
            { word: "교학상장 (敎學相長)", desc: "가르치고 배우면서 서로 발전함" },
            { word: "고진감래 (苦盡甘來)", desc: "고생이 끝나고 즐거움이 찾아옴" },
            { word: "주경야독 (晝耕夜讀)", desc: "낮에는 일하고 밤에는 공부함" },
            { word: "대기만성 (大器晩成)", desc: "큰 인물은 이루어지는 데 오랜 시간이 걸림" }
        ],
        proverb: [
            { word: "시작이 반이다", desc: "어떤 일이든 시작하는 것이 중요함" },
            { word: "원숭이도 나무에서 떨어진다", desc: "아무리 잘하는 사람도 실수할 수 있음" }
        ],
        textbook: [
            { word: "주제", desc: "글이나 말에서 가장 중심이 되는 생각" },
            { word: "요약", desc: "중요한 내용을 간추림" }
        ],
        camera: [
            { word: "역지사지 (處地思之)", desc: "처지를 바꾸어 생각함" },
            { word: "유비무환 (有備無患)", desc: "미리 준비가 있으면 근심이 없음" }
        ]
    };

    let currentCategory = [];
    let currentIndex = 0;
    let isCardFlipped = false;

    function switchScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
        if(screenId === 'screen-admin') renderKeyList();
    }

    function verifyLicense() {
        let val = document.getElementById('license-input').value.trim();
        let found = licenses.find(l => l.key === val && l.active);
        if (found) {
            document.getElementById('header-status').innerText = found.role === 'admin' ? '👑 관리자' : '🟢 인증됨';
            document.getElementById('admin-shortcut-box').style.display = found.role === 'admin' ? 'block' : 'none';
            switchScreen('screen-home');
        } else {
            alert('유효하지 않은 라이센스 키입니다.');
        }
    }

    function generateKey() {
        let newKey = document.getElementById('new-key-input').value.trim();
        if(!newKey) return alert('키를 입력하세요.');
        let role = newKey.includes('admin') ? 'admin' : 'user';
        licenses.push({ key: newKey, role: role, active: true });
        document.getElementById('new-key-input').value = '';
        renderKeyList();
        alert('발급 완료되었습니다.');
    }

    function renderKeyList() {
        let container = document.getElementById('key-list-container');
        container.innerHTML = '';
        licenses.forEach((item, index) => {
            container.innerHTML += `
                <div class="key-item">
                    <span><b>${item.key}</b> (${item.role})</span>
                    <button class="secondary" style="width:auto; padding:4px 8px; font-size:0.75rem;" onclick="licenses[${index}].active = !licenses[index].active; renderKeyList();">상태변경</button>
                </div>`;
        });
    }

    function startStudy(categoryKey) {
        currentCategory = studyData[categoryKey];
        currentIndex = 0;
        switchScreen('screen-study');
        updateCard();
    }

    function updateCard() {
        let item = currentCategory[currentIndex];
        document.getElementById('card-front').innerText = item.word;
        document.getElementById('card-back').innerText = item.desc;
        document.getElementById('card-back').style.display = 'none';
        isCardFlipped = false;
        document.getElementById('study-progress').innerText = `${currentIndex + 1} / ${currentCategory.length}`;
    }

    function flipCard() {
        isCardFlipped = !isCardFlipped;
        document.getElementById('card-back').style.display = isCardFlipped ? 'block' : 'none';
    }

    function nextCard() {
        currentIndex++;
        if (currentIndex >= currentCategory.length) {
            alert('학습을 모두 완료했습니다! 🎉');
            switchScreen('screen-home');
        } else {
            updateCard();
        }
    }
</script>
</body>
</html>
```[cite: 3]

